# Copy to `.env` and fill in. Used by docker-compose.yml.

# --- Public site URL (BAKED IN AT BUILD TIME; rebuild after changing) ---
# Domain root: https://example.com/   Subfolder: https://example.com/marketing/
NEXT_PUBLIC_SITE_URL=http://localhost:3000/

# --- Database (MySQL container) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sharper_marketing
MYSQL_USER=sharper
MYSQL_PASSWORD=change-me-db

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-long-random-string

# --- Email (server-side) ---
CONTACT_RECIPIENT_EMAIL=
NOREPLY_FROM_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Browser-side form delivery (BAKED IN AT BUILD TIME) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_ACK_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_SHEETS_WEBAPP_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Host port mapping ---
# 127.0.0.1 = only reachable through a reverse proxy (recommended, Caddy/nginx).
# 0.0.0.0   = reachable directly on the VPS IP.
APP_BIND=127.0.0.1
APP_PORT=3000
